{
  "name": "newsapp",
  "productName": "Information Hub",
  "version": "0.0.1",
  "description": "Desktop hub for your mail, calendars, priorities and fact-checked news.",
  "main": "out/main/index.js",
  "author": "Luis del Campo",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --publish never",
    "server:build": "esbuild server/index.ts --bundle --platform=node --target=node22 --outfile=server/dist/server.js",
    "server:dev": "npm run server:build && node server/dist/server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@azure/msal-node": "^7.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.2",
    "imapflow": "^2.9.1",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdav": "^2.5.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^18.0.1",
    "typescript": "~5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
